---
interface Props {
  language: string;
  filename?: string;
  code: string;
}

const { language, filename, code } = Astro.props;
---

<figure class="overflow-hidden rounded-xl border border-rule bg-[#0f0f12]">
  <figcaption
    class="flex items-center justify-between border-b border-white/10 px-4 py-2.5 font-mono text-[11px] uppercase tracking-widest text-white/60"
  >
    <span class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
      {language}
    </span>
    {filename && <span class="text-white/45">{filename}</span>}
  </figcaption>
  <pre
    class="overflow-x-auto px-5 py-4 font-mono text-[13px] leading-relaxed text-[#e8eaee]"><code>{code}</code></pre>
</figure>
