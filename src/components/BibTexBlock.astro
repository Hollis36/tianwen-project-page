---
interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;

const t =
  lang === 'zh'
    ? {
        eyebrow: '引用',
        title: '如果 TianWen 对你有帮助',
        body: '正式 preprint 与 BibTeX 将随论文发布。在此之前，请引用项目主页：',
        copy: '复制',
        copied: '已复制!',
        fallback: '请按 Ctrl/⌘+C',
      }
    : {
        eyebrow: 'Citation',
        title: 'If you use TianWen in your work',
        body: 'A formal preprint and BibTeX will be published with the upcoming paper. In the meantime, please cite the project page:',
        copy: 'Copy',
        copied: 'Copied!',
        fallback: 'Press Ctrl/⌘+C',
      };

const bibtex = `@misc{zhang2026tianwen,
  title  = {TianWen: A Universal Training Framework for Detection-VLM Fusion},
  author = {Zhang, Peifu},
  year   = {2026},
  note   = {Project page: https://hollis36.github.io/tianwen-project-page/},
  url    = {https://github.com/Hollis36/TianWen}
}`;
---

<section id="bibtex" class="tone-warm py-16 sm:py-20">
  <div class="container-narrow">
    <p class="section-eyebrow">{t.eyebrow}</p>
    <h2 class="section-title mt-2">{t.title}</h2>
    <p class="mt-4 text-[15px] leading-relaxed text-ink-soft dark:text-night-soft">
      {t.body}
    </p>

    <figure class="mt-6 overflow-hidden rounded-xl border border-rule dark:border-night-rule bg-[#0f0f12]">
      <figcaption
        class="flex items-center justify-between border-b border-white/10 px-4 py-2.5 font-mono text-[11px] uppercase tracking-widest text-white/60"
      >
        <span class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
          BibTeX
        </span>
        <button
          type="button"
          id="copy-bibtex"
          data-copied={t.copied}
          data-default={t.copy}
          data-fallback={t.fallback}
          class="rounded-md border border-white/15 px-2.5 py-1 font-mono text-[11px] text-white/85 transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          {t.copy}
        </button>
      </figcaption>
      <pre
        id="bibtex-content"
        class="overflow-x-auto px-5 py-4 font-mono text-[12.5px] leading-relaxed text-[#e8eaee]"
      ><code>{bibtex}</code></pre>
    </figure>
  </div>
</section>

<script is:inline>
  (() => {
    const btn = document.getElementById('copy-bibtex');
    const pre = document.getElementById('bibtex-content');
    if (!btn || !pre) return;
    const copied = btn.dataset.copied || 'Copied!';
    const fallback = btn.dataset.fallback || 'Press Ctrl/⌘+C';
    const def = btn.dataset.default || 'Copy';
    btn.addEventListener('click', async () => {
      const text = pre.innerText.trim();
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = copied;
        setTimeout(() => {
          btn.textContent = def;
        }, 1600);
      } catch {
        btn.textContent = fallback;
      }
    });
  })();
</script>
