---
const year = new Date().getFullYear();
---

<footer class="border-t border-rule bg-paper py-10">
  <div class="container-wide">
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <div class="text-center text-sm text-ink-mute sm:text-left">
        <p>
          <span class="font-serif text-ink">TianWen 天问</span> — released under the
          <a
            href="https://github.com/Hollis36/TianWen/blob/main/LICENSE"
            target="_blank"
            rel="noopener noreferrer">Apache 2.0 License</a
          >.
        </p>
        <p class="mt-1">
          © {year} Peifu Zhang · Built with
          <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> ·
          <a href="https://hollis36.github.io/" target="_blank" rel="noopener noreferrer"
            >hollis36.github.io</a
          >
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="https://github.com/Hollis36/TianWen"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="TianWen on GitHub"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-rule bg-white text-ink no-underline transition hover:bg-ink hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M12 .5C5.65.5.5 5.66.5 12.02c0 5.09 3.29 9.4 7.86 10.93.58.1.79-.25.79-.55 0-.27-.01-1.16-.02-2.1-3.2.7-3.87-1.36-3.87-1.36-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.14 1.18a10.84 10.84 0 015.72 0c2.18-1.49 3.13-1.18 3.13-1.18.63 1.57.23 2.73.11 3.02.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.35.77 1.04.77 2.1 0 1.52-.01 2.74-.01 3.11 0 .3.21.66.79.55 4.57-1.53 7.86-5.83 7.86-10.93C23.5 5.66 18.35.5 12 .5z"
            ></path>
          </svg>
        </a>
        <a
          href="https://hollis36.github.io/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Peifu Zhang's homepage"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-rule bg-white text-ink no-underline transition hover:bg-ink hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 11l9-7 9 7M5 10v9h14v-9M10 19v-6h4v6"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
