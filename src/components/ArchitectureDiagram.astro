---
// Architecture: configs (Hydra) -> Trainer (Lightning) -> Modules (Detector | VLM | Fusion)
---

<figure class="mx-auto max-w-4xl">
  <svg
    viewBox="0 0 900 360"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label="Architecture: Hydra configs configure detectors, VLMs, and fusion modules that the Lightning trainer orchestrates."
    class="block h-auto w-full"
  >
    <defs>
      <marker id="arr2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" fill="#1a1a1a" />
      </marker>
    </defs>

    <!-- Configs column -->
    <g>
      <rect x="30" y="40" width="200" height="280" rx="12" fill="#f5f3ef" stroke="#e5e5e5" />
      <text x="130" y="68" text-anchor="middle" font-family="'Source Serif 4',serif" font-size="16" font-weight="700" fill="#1a1a1a">Hydra Configs</text>
      <text x="130" y="86" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="11" fill="#6b6b6b">hierarchical · composable</text>

      <g font-family="JetBrains Mono,monospace" font-size="12" fill="#3f3f3f">
        <rect x="50" y="108" width="160" height="30" rx="6" fill="#ffffff" stroke="#e5e5e5"/>
        <text x="60" y="128">detector/</text>
        <rect x="50" y="148" width="160" height="30" rx="6" fill="#ffffff" stroke="#e5e5e5"/>
        <text x="60" y="168">vlm/</text>
        <rect x="50" y="188" width="160" height="30" rx="6" fill="#ffffff" stroke="#e5e5e5"/>
        <text x="60" y="208">fusion/</text>
        <rect x="50" y="228" width="160" height="30" rx="6" fill="#ffffff" stroke="#e5e5e5"/>
        <text x="60" y="248">dataset/</text>
        <rect x="50" y="268" width="160" height="30" rx="6" fill="#ffffff" stroke="#e5e5e5"/>
        <text x="60" y="288">experiment/</text>
      </g>
    </g>

    <!-- Arrow to trainer -->
    <path d="M230 180 L300 180" stroke="#1a1a1a" stroke-width="1.4" fill="none" marker-end="url(#arr2)" />

    <!-- Trainer -->
    <g>
      <rect x="300" y="120" width="220" height="120" rx="14" fill="#1a1a1a" />
      <text x="410" y="156" text-anchor="middle" font-family="'Source Serif 4',serif" font-size="18" font-weight="700" fill="#ffffff">Training Engine</text>
      <text x="410" y="180" text-anchor="middle" font-family="Inter,sans-serif" font-size="12" fill="#dbeafe">PyTorch Lightning</text>
      <text x="410" y="208" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="11" fill="#9aa0aa">callbacks · multi-GPU · logging</text>
    </g>

    <!-- Arrow to modules column -->
    <path d="M520 180 L600 100" stroke="#1a1a1a" stroke-width="1.4" fill="none" marker-end="url(#arr2)" />
    <path d="M520 180 L600 180" stroke="#1a1a1a" stroke-width="1.4" fill="none" marker-end="url(#arr2)" />
    <path d="M520 180 L600 260" stroke="#1a1a1a" stroke-width="1.4" fill="none" marker-end="url(#arr2)" />

    <!-- Modules -->
    <g font-family="Inter,sans-serif" font-size="13" font-weight="600" fill="#1a1a1a">
      <rect x="600" y="76" width="260" height="56" rx="10" fill="#ffffff" stroke="#e5e5e5"/>
      <text x="615" y="100">Detectors</text>
      <text x="615" y="118" font-family="JetBrains Mono,monospace" font-size="11" font-weight="400" fill="#6b6b6b">tianwen/detectors/*</text>

      <rect x="600" y="156" width="260" height="56" rx="10" fill="#ffffff" stroke="#e5e5e5"/>
      <text x="615" y="180">VLMs</text>
      <text x="615" y="198" font-family="JetBrains Mono,monospace" font-size="11" font-weight="400" fill="#6b6b6b">tianwen/vlms/*</text>

      <rect x="600" y="236" width="260" height="56" rx="10" fill="#ffffff" stroke="#1a1a1a" stroke-width="1.5"/>
      <text x="615" y="260">Fusions</text>
      <text x="615" y="278" font-family="JetBrains Mono,monospace" font-size="11" font-weight="400" fill="#6b6b6b">tianwen/fusions/*</text>
    </g>

    <!-- Registry label -->
    <text x="730" y="332" text-anchor="middle" font-family="Inter,sans-serif" font-size="11" fill="#6b6b6b" font-style="italic">All modules registered through @REGISTRY decorators — drop-in extensible.</text>
  </svg>
  <figcaption class="mt-3 text-center text-sm text-ink-mute">
    Hierarchical configs flow into a Lightning trainer that dispatches to plug-in modules.
  </figcaption>
</figure>
