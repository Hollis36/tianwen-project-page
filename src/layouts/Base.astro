---
import '../styles/global.css';
import TopNav from '../components/TopNav.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: 'en' | 'zh';
  starCount?: number | null;
}

const {
  title = 'TianWen — A Universal Training Framework for Detection-VLM Fusion',
  description = 'TianWen (天问) is a modular framework that combines object detection models with Vision-Language Models through knowledge distillation, feature fusion, and decision fusion strategies.',
  ogImage,
  lang = 'en',
  starCount = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogPath = ogImage ?? `${import.meta.env.BASE_URL}/og-image.png`.replace(/\/+/g, '/');
const ogImageUrl = new URL(ogPath, Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}/favicon.svg`.replace(/\/+/g, '/')}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0c10" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('tw-theme');
          const sys = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && sys)) {
            document.documentElement.classList.add('dark');
          }
        } catch {
          /* noop */
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-3 focus:py-2 focus:text-white focus:no-underline"
    >
      Skip to content
    </a>
    <TopNav lang={lang} starCount={starCount} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
